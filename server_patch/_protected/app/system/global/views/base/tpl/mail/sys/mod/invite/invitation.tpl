{inc_header}
{inc_sub_header}

<div style="text-align:left; color:#222; line-height:1.55;">
    <p style="margin:0 0 16px;">Hello,</p>

    <p style="margin:0 0 16px;">
        {sender_name} has invited you to discover SharedChemistry, a private adult couples community built for real couple-to-couple connection.
    </p>

    <p style="margin:0 0 16px;">
        SharedChemistry is designed for adult couples who want a more private, social, and chemistry-focused way to meet other couples.
    </p>

    <p style="margin:0 0 8px;"><strong>Message from {sender_name}:</strong></p>
    <blockquote style="margin:0 0 18px; padding:12px 14px; border-left:3px solid #75616f; background:#f7f4f6; color:#333;">
        {custom_message}
    </blockquote>

    <p style="margin:0 0 8px;">You can visit SharedChemistry here:</p>
    <p style="margin:0 0 18px;">
        <a href="{site_url}" style="color:#5a3650; font-weight:bold;">{site_url}</a>
    </p>

    <p style="margin:0 0 18px;">
        <a href="{signup_url}" style="display:inline-block; padding:10px 14px; background:#5a3650; color:#fff; text-decoration:none; border-radius:3px; font-weight:bold;">Visit SharedChemistry</a>
    </p>
</div>

<hr />
<p>Best regards,<br />The SharedChemistry team</p>
<p>
    <small>{footer}</small>
</p>

{inc_footer}

